#include <windows.h>

#define CARBON_DIALOG DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN

2100 DIALOGEX 0, 0, 280, 186
STYLE CARBON_DIALOG
CAPTION "New vanilla instance"
FONT 10, "Segoe UI"
BEGIN
    LTEXT       "Instance &name", -1, 13, 11, 253, 11
    EDITTEXT    1101, 13, 25, 254, 18, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT       "Minecraft &version", -1, 13, 56, 113, 11
    COMBOBOX    1102, 141, 52, 126, 90, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT       "Maximum &memory (MiB)", -1, 13, 81, 122, 11
    EDITTEXT    1103, 141, 77, 72, 18, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT       "Window &width (px)", -1, 13, 106, 122, 11
    EDITTEXT    1104, 141, 102, 72, 18, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT       "Window &height (px)", -1, 13, 131, 122, 11
    EDITTEXT    1105, 141, 127, 72, 18, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Create instance", IDOK, 0, 156, 140, 30
    PUSHBUTTON    "Cancel", IDCANCEL, 140, 156, 140, 30
END

2101 DIALOGEX 0, 0, 267, 83
STYLE CARBON_DIALOG
CAPTION "Clone instance"
FONT 10, "Segoe UI"
BEGIN
    LTEXT       "&Name for the copy", -1, 13, 10, 241, 11
    EDITTEXT    1101, 13, 24, 241, 18, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Create copy", IDOK, 0, 53, 133, 30
    PUSHBUTTON    "Cancel", IDCANCEL, 133, 53, 134, 30
END

2102 DIALOGEX 0, 0, 300, 153
STYLE CARBON_DIALOG
CAPTION "Import pack"
FONT 10, "Segoe UI"
BEGIN
    EDITTEXT     1200, 13, 12, 274, 102, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Import pack", IDOK, 0, 123, 150, 30
    PUSHBUTTON    "Cancel", IDCANCEL, 150, 123, 150, 30
END

2103 DIALOGEX 0, 0, 284, 91
STYLE CARBON_DIALOG
CAPTION "Carbon Desktop"
FONT 10, "Segoe UI"
BEGIN
    LTEXT        "", 1200, 13, 12, 258, 44, SS_NOPREFIX | SS_EDITCONTROL
    DEFPUSHBUTTON "Close", IDOK, 0, 61, 284, 30
END

2104 DIALOGEX 0, 0, 306, 190
STYLE CARBON_DIALOG
CAPTION "Minecraft accounts"
FONT 10, "Segoe UI"
BEGIN
    LTEXT          "", 1300, 13, 10, 280, 14, SS_NOPREFIX
    LTEXT          "", 1301, 13, 29, 280, 33, SS_NOPREFIX | SS_EDITCONTROL
    LTEXT          "", 1302, 13, 68, 170, 12, SS_NOPREFIX
    LTEXT          "Saved &accounts", 1303, 13, 92, 280, 12
    COMBOBOX       1304, 13, 107, 280, 100, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON     "Refresh account", 1305, 13, 132, 112, 20
    PUSHBUTTON     "Sign out", 1306, 131, 132, 112, 20
    PUSHBUTTON     "Copy code", 1307, 188, 63, 105, 20
    PUSHBUTTON     "Cancel operation", 1308, 13, 132, 112, 20
    PUSHBUTTON     "Sign in with Microsoft", IDOK, 0, 160, 153, 30
    DEFPUSHBUTTON  "Close", IDCANCEL, 153, 160, 153, 30
END
