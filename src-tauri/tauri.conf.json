{
  "productName": "Carbon Desktop",
  "version": "0.0.0",
  "identifier": "dev.carbonmine.desktop.review",
  "build": {
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Carbon Desktop",
        "width": 1040,
        "height": 760,
        "minWidth": 380,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/128x128.png"
    ]
  }
}
